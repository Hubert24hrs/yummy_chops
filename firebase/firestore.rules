rules_version = '2';

// Yummy Chops: Firestore rules. The apps and websites never read or write Firestore themselves: everything goes
// through the API (Admin SDK), which shows each person only their own view of an order. A shop sees the area, not
// the customer's address or phone; a rider sees a job only while it is theirs; settlement figures stay with staff.
// Direct client access would go around those views, so it is closed. When an app needs a live listener, open one
// purpose-made collection here that holds only what its readers may see, with a test in tests/.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
