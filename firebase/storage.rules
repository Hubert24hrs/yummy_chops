rules_version = '2';

// Yummy Chops: Cloud Storage rules. Files reach the bucket only through the API: riders' KYC documents under
// applications/{uid}/, which only the rider and the team's reviewers can open, through the API. The apps and
// websites never read or write the bucket directly, so nothing is open to them (no free uploads at our cost either).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
